<Window x:Class="EQLDamageMeter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Damage Overlay" Width="460" Height="220" MinWidth="360" MinHeight="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        PreviewMouseLeftButtonDown="Overlay_PreviewMouseLeftButtonDown">
    <!-- A 1/255 alpha surface is visually transparent, but unlike alpha zero it remains
         part of Windows hit testing so the entire overlay can be dragged. -->
    <Border Background="#01000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="7">
        <Grid>
            <ListBox ItemsSource="{Binding Combatants}" Background="Transparent" BorderThickness="0"
                     Margin="0,0,27,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42">
                            <ProgressBar Value="{Binding Damage}"
                                         Maximum="{Binding DataContext.MaxDamage, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                         Background="#11192A" Foreground="{StaticResource PrimaryBrush}"
                                         BorderThickness="0" Opacity="0.72" />
                            <Grid Margin="9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Rank, StringFormat=#{0}}"
                                           VerticalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DamageText, StringFormat={}{0} DMG}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{Binding DpsText, StringFormat={}{0} DPS}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontWeight="Bold" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="&#x00D7;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="23" Height="23" Padding="0" FontSize="14" Panel.ZIndex="2"
                    ToolTip="Close overlay" Click="Close_Click" />
        </Grid>
    </Border>
</Window>
