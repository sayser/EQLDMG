<Window x:Class="EQLDamageMeter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Damage Overlay" Width="460" Height="220" MinWidth="200" MinHeight="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        SizeChanged="Overlay_SizeChanged"
        PreviewMouseLeftButtonDown="Overlay_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <!-- A 1/255 alpha surface is visually transparent, but unlike alpha zero it remains
         part of Windows hit testing so the entire overlay can be dragged. -->
    <Border Background="#01000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding CompanionHint}" TextWrapping="Wrap"
                       Foreground="#FFBD57" FontSize="11" Margin="6,2,28,6"
                       Visibility="{Binding HasCompanionHint, Converter={StaticResource BooleanToVisibility}}" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Combatants}" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42">
                            <ProgressBar Value="{Binding Damage}"
                                         Maximum="{Binding DataContext.MaxDamage, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                         Background="#11192A" Foreground="{Binding BarBrush}"
                                         BorderThickness="0" Opacity="0.72" />
                            <Grid Margin="9,0,28,0">
                                <Grid.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Grid.Effect>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" MinWidth="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Rank, StringFormat=#{0}}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{Binding DamageText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDamageMetric, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowMetricUnits, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Text" Value="{Binding DamageText, StringFormat={}{0} DMG}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="Text" Value="{Binding DpsText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowMetricUnits, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Text" Value="{Binding DpsText, StringFormat={}{0} DPS}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="&#x00D7;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="23" Height="23" Padding="0" FontSize="14" Panel.ZIndex="2"
                    ToolTip="Close overlay" Click="Close_Click" />
        </Grid>
    </Border>
</Window>
