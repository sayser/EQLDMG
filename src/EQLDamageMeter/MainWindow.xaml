<Window x:Class="EQLDamageMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EQLDamageMeter.Controls"
        Title="EQL Damage Meter" Icon="Assets/EQDM.ico"
        Height="900" Width="1600" MinHeight="760" MinWidth="1180"
        Background="#061522" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#071522" Offset="0" />
            <GradientStop Color="#08263A" Offset="0.46" />
            <GradientStop Color="#081A2B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderGlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#88092236" Offset="0" />
            <GradientStop Color="#780B3349" Offset="0.48" />
            <GradientStop Color="#88092033" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#72082235" Offset="0" />
            <GradientStop Color="#620A3147" Offset="0.48" />
            <GradientStop Color="#72071D30" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DamageGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7957F5" Offset="0" />
            <GradientStop Color="#9B70FF" Offset="0.72" />
            <GradientStop Color="#B49AFF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
            <Setter Property="BorderBrush" Value="#56839C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.32" Color="#001018" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InnerCard" TargetType="Border">
            <Setter Property="Background" Value="#B00C2B40" />
            <Setter Property="BorderBrush" Value="#416A83" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89A9C1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8D4E5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#102A3D" />
            <Setter Property="BorderBrush" Value="#56839C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="#E8F8FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E8F8FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#A3153A50" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#57A99F" />
                                <Setter Property="Foreground" Value="#E5F7FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A8496" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModuleNavigationButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CB9CA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="#6A0A2032" BorderBrush="#42677F" BorderThickness="1"
                                CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#A3153A50" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#57A99F" />
                                <Setter Property="Foreground" Value="#E5F7FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B65D48B8" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A98BFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#78091F31" />
            <Setter Property="BorderBrush" Value="#4F7891" />
        </Style>
        <Style x:Key="BuffInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#EDF7FF" />
            <Setter Property="Background" Value="#A0092235" />
            <Setter Property="BorderBrush" Value="#42677F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="#9A78FF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="BuffComboItemTemplate">
            <TextBlock Text="{Binding}" Foreground="#EDF7FF" FontWeight="SemiBold" />
        </DataTemplate>
        <ControlTemplate x:Key="BuffComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    CornerRadius="4">
                <Path Data="M 0,0 L 7,7 L 14,0" Stroke="#A9C3D3" StrokeThickness="1.6"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      Width="12" Height="7" Stretch="Fill" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A93AB" />
                    <Setter TargetName="Chrome" Property="Background" Value="#B0122E44" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#A98BFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="BuffCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDF7FF" />
            <Setter Property="Background" Value="#A0092235" />
            <Setter Property="BorderBrush" Value="#42677F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemTemplate" Value="{StaticResource BuffComboItemTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EDF7FF" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#3A5A72" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#684CC0" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ItemBd" Property="Background" Value="#7B5DD4" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource BuffComboToggleTemplate}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#122636" BorderBrush="#5A7F96" BorderThickness="1" CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact width for Alert Type (fits "TextToSpeech") -->
        <Style x:Key="BuffComboAlert" TargetType="ComboBox" BasedOn="{StaticResource BuffCombo}">
            <Setter Property="Width" Value="128" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#102A3D" />
            <Setter Property="Background" Value="#EFF9FC" />
            <Setter Property="BorderBrush" Value="#4E7A91" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <Style x:Key="BuffToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="#34495A" BorderBrush="#537086" BorderThickness="1" CornerRadius="11" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" Fill="#E8F5FC" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#714FCD" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A98BFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.86" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BuffFilter" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CB9CA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="#65091F31" BorderBrush="#3E627A" BorderThickness="1" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#A65D48B8" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A98BFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DamageBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="#071723" />
            <Setter Property="Foreground" Value="{StaticResource DamageGradient}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="9" />
                            <Border x:Name="PART_Track" CornerRadius="9" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                    CornerRadius="9" Opacity="0.93" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InvisibleScrollButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArcaneScrollThumb" TargetType="Thumb">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome" Margin="2" CornerRadius="5" Background="#A5785BE3"
                                BorderBrush="#A99B83FF" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.42" Color="#6F4DE0" /></Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#B52ECFBE" /><Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#78F0E1" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#D29B78FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbChrome" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="#7A061825" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#466D84" BorderThickness="1" CornerRadius="6">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ArcaneScrollThumb}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}" BorderBrush="#466D84" BorderThickness="1" CornerRadius="6">
                                    <Track x:Name="PART_Track" Orientation="Horizontal"
                                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageLeftCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.DecreaseRepeatButton>
                                        <Track.Thumb><Thumb Style="{StaticResource ArcaneScrollThumb}" /></Track.Thumb>
                                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageRightCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowGradient}">
        <Image Source="Assets/ArcaneBackdrop.png" Stretch="Fill" StretchDirection="Both"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" Opacity="1" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#08000000" Offset="0" />
                    <GradientStop Color="#14031524" Offset="0.52" />
                    <GradientStop Color="#26030D18" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse Width="720" Height="390" Fill="#1239D3C2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="120,-250,0,0">
            <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="620" Height="340" Fill="#157C5CFC" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,80,0">
            <Ellipse.Effect><BlurEffect Radius="100" /></Ellipse.Effect>
        </Ellipse>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="158" />
                <RowDefinition Height="10" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <!-- Branded command header -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGlow}" BorderBrush="#56839C" BorderThickness="1"
                    CornerRadius="22" Padding="12">
                <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.35" Color="#001018" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="96" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" MinHeight="38" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="76" Height="76" Background="#8A071A28" BorderBrush="#5B879F" BorderThickness="1"
                                CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Image Source="Assets/EQDM.png" Width="70" Height="70" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CharacterNameUpper}" FontSize="34" FontWeight="Light" Foreground="#E8F8FF" />
                            <TextBlock Text="EQL  DAMAGE  METER" Foreground="#8FDCD9" FontSize="12" FontWeight="SemiBold" Margin="2,3,0,0" />
                            <TextBlock Text="{Binding AppVersionText}" Foreground="#7FA3B8" FontSize="11"
                                       FontWeight="SemiBold" Margin="2,4,0,0" />
                            <Border BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="2,8,0,0"
                                    HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#481E1014" />
                                        <Setter Property="BorderBrush" Value="#A9414D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLogOnline}" Value="True">
                                                <Setter Property="Background" Value="#193E3D" />
                                                <Setter Property="BorderBrush" Value="#2B7A70" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF5E70" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#39E0CC" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding MonitorStatusText}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF6978" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogOnline}" Value="True">
                                                        <Setter Property="Foreground" Value="#91F2E6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="2" Background="#BA081F31" BorderBrush="#4F7891" BorderThickness="1"
                            CornerRadius="16" Padding="8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="Auto" MinWidth="150" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="#D8EDFA" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Character" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding CharacterName}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerName, StringFormat={}Server: {0}}" Foreground="#8BA9BD" FontSize="10" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Column="1" Background="#315268" Margin="0,9" />

                            <Grid Grid.Column="2" Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="◎" FontSize="36" FontWeight="Light" Foreground="#C8E6F5" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Mode" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding ModeText}" Style="{StaticResource MetricValue}" Foreground="#2ED9C7" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Column="3" Background="#315268" Margin="0,9" />

                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="12,2,8,2">
                                <Button x:Name="SettingsButton" Style="{StaticResource HeaderActionButton}"
                                        Content="Settings" Margin="0,0,0,5"
                                        Click="Settings_Click" ToolTip="Open settings">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Logs folder…" Click="ChooseLogs_Click"
                                                      ToolTip="Choose the EverQuest Legends Logs folder" />
                                            <MenuItem Header="Populate session from last 3h of log"
                                                      Click="PopulateSessionFromLog_Click"
                                                      ToolTip="Rebuild a test session from the last 3 hours of the loaded character log" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="OverlaysToggleButton" Style="{StaticResource HeaderActionButton}"
                                        Content="Open all overlays" Margin="0,0,0,5"
                                        Click="ToggleAllOverlays_Click"
                                        ToolTip="Open or close DPS, Buff, DoT, and Control overlays" />
                                <Button Style="{StaticResource HeaderActionButton}" Content="Updates"
                                        Click="CheckUpdates_Click" ToolTip="{Binding UpdateButtonToolTip}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#62071C2D" BorderBrush="#355B73"
                            BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" Padding="6,5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DpsParserButton" Content="DPS Parser" GroupName="PrimaryModule"
                                         IsChecked="True" Style="{StaticResource ModuleNavigationButton}" />
                            <RadioButton x:Name="SpellTrackerButton" Content="Spell Tracker" GroupName="PrimaryModule"
                                         Style="{StaticResource ModuleNavigationButton}" />
                            <RadioButton x:Name="SessionTrackerButton" Content="Session Tracker" GroupName="PrimaryModule"
                                         Style="{StaticResource ModuleNavigationButton}" MinWidth="148" />
                            <RadioButton x:Name="QuestTrackerButton" Content="Quest Tracker" GroupName="PrimaryModule"
                                         Style="{StaticResource ModuleNavigationButton}" MinWidth="138" />
                            <RadioButton x:Name="SkyTrackerButton" Content="Plane of Sky" GroupName="PrimaryModule"
                                         Style="{StaticResource ModuleNavigationButton}" MinWidth="138" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Grid Grid.Row="2" Visibility="{Binding IsChecked, ElementName=DpsParserButton, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚔" FontSize="18" Foreground="#A7C8DA" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="DPS RANKING" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="Current encounter" Foreground="#66879D" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,18,0">
                                <TextBlock Text="◷" FontSize="22" FontWeight="Light" Foreground="#C8E6F5"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Duration" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding EncounterTime}" Style="{StaticResource MetricValue}"
                                               Foreground="#F2FAFF" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Content="Combine pet DPS with owner"
                                          IsChecked="{Binding CombinePetDamage, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Foreground="#C8DEEA" FontSize="11" Margin="0,0,12,0"
                                          ToolTip="Combine regular and charmed pet damage into the owner's DPS row" />
                                <Button Content="DPS Overlay" Padding="10,6" Margin="0,0,6,0" Click="ToggleOverlay_Click"
                                        ToolTip="Open the DPS ranking overlay window" />
                                <Button Content="Reset" Padding="12,6" Click="ResetEncounter_Click"
                                        ToolTip="Reset the current DPS encounter" />
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedCombatant}"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" Background="#6A0E2A3E" BorderBrush="#31566E" BorderThickness="1"
                                                        CornerRadius="12" Padding="8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="#50CFC5" />
                                                        <Setter TargetName="Chrome" Property="Background" Value="#9A103249" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#A5163A50" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="66">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" /><ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hits, StringFormat={}{0} hits}" FontSize="11" Foreground="#91B0C4" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Style="{StaticResource DamageBarStyle}" Height="20"
                                                     Value="{Binding Damage}" Maximum="{Binding DataContext.MaxDamage, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     VerticalAlignment="Center" Margin="8,0,18,0" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DamageText}" FontSize="19" FontWeight="SemiBold" />
                                            <TextBlock Text="DAMAGE" FontSize="9" Foreground="#86A6BA" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DpsText}" FontSize="24" FontWeight="SemiBold" Foreground="#AB8EFF" />
                                            <TextBlock Text="DPS" FontSize="9" Foreground="#86A6BA" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Analysis inspector -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" /><RowDefinition Height="32" />
                            <RowDefinition Height="148" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Margin="2,2,2,0" CornerRadius="17,17,0,0" Background="#9A071C2D"
                                BorderBrush="#527B94" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border CornerRadius="16,0,0,0" BorderBrush="#355B73" BorderThickness="0,0,1,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#32102B40" /><Style.Triggers><DataTrigger Binding="{Binding OffenseVisibility}" Value="Visible"><Setter Property="Background" Value="#C7684EC9" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Button Content="Offense" Click="ShowOffense_Click" Background="Transparent" BorderThickness="0" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#355B73" BorderThickness="0,0,1,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#32102B40" /><Style.Triggers><DataTrigger Binding="{Binding DefenseVisibility}" Value="Visible"><Setter Property="Background" Value="#C7684EC9" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Button Content="Defense" Click="ShowDefense_Click" Background="Transparent" BorderThickness="0" />
                                </Border>
                                <Border Grid.Column="2" CornerRadius="0,16,0,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#32102B40" /><Style.Triggers><DataTrigger Binding="{Binding HealingVisibility}" Value="Visible"><Setter Property="Background" Value="#B8146B69" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Button Content="Healing" Click="ShowHealing_Click" Background="Transparent" BorderThickness="0" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="15,4,15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DAMAGE BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10"
                                           VerticalAlignment="Center" Visibility="{Binding OffenseVisibility}" />
                                <TextBlock Text="DEFENSE BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10"
                                           VerticalAlignment="Center" Visibility="{Binding DefenseVisibility}" />
                                <TextBlock Text="HEALING BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10"
                                           VerticalAlignment="Center" Visibility="{Binding HealingVisibility}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedName}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- Offense metrics -->
                        <Grid Grid.Row="2" Margin="15,2,15,2" ClipToBounds="False" Visibility="{Binding OffenseVisibility}">
                            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="HITS" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.Hits}" FontSize="14" FontWeight="Bold" /></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="MISSED" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.Misses}" FontSize="14" FontWeight="Bold" Foreground="#FFBD57" /></StackPanel></Border>
                                <Border Grid.Column="4" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="CRIT %" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.CriticalRateText}" FontSize="14" FontWeight="Bold" Foreground="#FFBD57" /></StackPanel></Border>
                                <Border Grid.Column="6" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="SPELL CRIT %" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.SpellCriticalRateText}" FontSize="14" FontWeight="Bold" Foreground="#2FD8C7" /></StackPanel></Border>
                                <Border Grid.Column="8" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="RESISTED" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.SpellResists}" FontSize="14" FontWeight="Bold" Foreground="#FF6C91" /></StackPanel></Border>
                                <Border Grid.Column="10" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="FIZZLED" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.SpellFizzles}" FontSize="14" FontWeight="Bold" Foreground="#A985FF" /></StackPanel></Border>
                                <Border Grid.Column="12" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="STUNS" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.StunsLanded}" FontSize="14" FontWeight="Bold" Foreground="#7FC6FF" /></StackPanel></Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,2,0,0" ClipToBounds="False">
                                <controls:DonutChart Width="118" Height="96" ItemsSource="{Binding SelectedAbilities}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Healing metrics -->
                        <Grid Grid.Row="2" Margin="15,2,15,2" ClipToBounds="False" Visibility="{Binding HealingVisibility}">
                            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="HEALING" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.HealingText}" FontSize="14" FontWeight="Bold" Foreground="#2FD8C7" /></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="HPS" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.HpsText}" FontSize="14" FontWeight="Bold" Foreground="#A985FF" /></StackPanel></Border>
                                <Border Grid.Column="4" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="DIRECT" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.DirectHeals}" FontSize="14" FontWeight="Bold" /></StackPanel></Border>
                                <Border Grid.Column="6" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="HOT TICKS" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.HealOverTimeTicks}" FontSize="14" FontWeight="Bold" /></StackPanel></Border>
                                <Border Grid.Column="8" Style="{StaticResource InnerCard}" Padding="6,3"><StackPanel><TextBlock Text="HEAL CRIT %" Style="{StaticResource MetricLabel}" FontSize="9" /><TextBlock Text="{Binding SelectedCombatant.HealingCriticalRateText}" FontSize="14" FontWeight="Bold" Foreground="#FFBD57" /></StackPanel></Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,2,0,0" ClipToBounds="False">
                                <controls:DonutChart Width="118" Height="96" ItemsSource="{Binding SelectedAbilities}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Defense charts -->
                        <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="15,4,10,8"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      Visibility="{Binding DefenseVisibility}">
                            <StackPanel Margin="0,0,6,0">
                                <Grid Height="54">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="DAMAGE TAKEN" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.DamageTakenText}" FontSize="16" FontWeight="Bold" /></StackPanel></Border>
                                    <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="AVOIDANCE" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.AvoidanceRateText}" FontSize="16" FontWeight="Bold" Foreground="#2FD8C7" /></StackPanel></Border>
                                    <Border Grid.Column="4" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="RESISTS" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.IncomingSpellResists}" FontSize="16" FontWeight="Bold" Foreground="#A985FF" /></StackPanel></Border>
                                    <Border Grid.Column="6" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="ABSORBED" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.Absorbed}" FontSize="16" FontWeight="Bold" /></StackPanel></Border>
                                    <Border Grid.Column="8" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="STUNNED" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.StunsTaken}" FontSize="16" FontWeight="Bold" Foreground="#FF6C91" /></StackPanel></Border>
                                </Grid>

                                <TextBlock Text="MITIGATION OUTCOMES" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <Grid Height="140" Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <controls:DonutChart Width="145" Height="120" ItemsSource="{Binding SelectedMitigations}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ListBox Grid.Column="1" ItemsSource="{Binding SelectedMitigations}" Background="Transparent" BorderThickness="0" Padding="4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><Ellipse Fill="{Binding Color}" Width="8" Height="8" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding DamageText}" HorizontalAlignment="Right" TextAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding ShareText}" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#96B7CA" /></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Column="1" Text="No mitigation outcomes recorded" Foreground="#7899AD" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedMitigations.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Border Height="1" Background="#31546A" />
                                <TextBlock Text="INCOMING DAMAGE BY ABILITY" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <Grid MinHeight="140" Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <controls:DonutChart Width="145" Height="120" ItemsSource="{Binding SelectedIncomingAbilities}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" />
                                    <ListBox Grid.Column="1" ItemsSource="{Binding SelectedIncomingAbilities}" Background="Transparent" BorderThickness="0" Padding="4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" /><ColumnDefinition Width="58" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,5,0"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <Ellipse Fill="{Binding Color}" Width="8" Height="8" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DamageText}" HorizontalAlignment="Right" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ShareText}" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#96B7CA" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Column="1" Text="No incoming damage recorded" Foreground="#7899AD" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIncomingAbilities.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Ability breakdown table -->
                        <Grid Grid.Row="3" Margin="15,4,15,6">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding DefenseVisibility}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="ABILITY BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="1" Background="#9A0B263A" BorderBrush="#355B73" BorderThickness="1" CornerRadius="8,8,0,0" TextElement.FontSize="9">
                                <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="Ability" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Damage" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding OffenseVisibility}" /><TextBlock Grid.Column="1" Text="Healing" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HealingVisibility}" /><TextBlock Grid.Column="2" Text="DPS" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding OffenseVisibility}" /><TextBlock Grid.Column="2" Text="HPS" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HealingVisibility}" /><TextBlock Grid.Column="3" Text="% of Total" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            </Border>
                            <ListBox Grid.Row="2" ItemsSource="{Binding SelectedAbilities}" Background="#71071F31" BorderBrush="#355B73" BorderThickness="1,0,1,1" Padding="4" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Height="26" Margin="5,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▶" Width="14" Foreground="#A98BFF" VerticalAlignment="Center">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsPetSummary}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding DataContext.IsPetDamageExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Text" Value="▼" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Border Width="12" Height="12" CornerRadius="3" Background="#152F43"
                                                            BorderBrush="{Binding Color}" BorderThickness="1" Margin="0,0,7,0"
                                                            VerticalAlignment="Center">
                                                        <Ellipse Fill="{Binding Color}" Width="5" Height="5" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8F4FF" /><Style.Triggers><DataTrigger Binding="{Binding IsPetSummary}" Value="True"><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#D8CCFF" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DamageText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="{Binding DpsText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <Grid Grid.Column="3" Margin="10,0,0,0"><TextBlock Text="{Binding ShareText}" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#A7C2D3" /><ProgressBar Value="{Binding Share}" Maximum="100" Width="42" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#132B3E" Foreground="#9875FF" /></Grid>
                                                <ToggleButton Grid.ColumnSpan="4" Background="Transparent" BorderThickness="0"
                                                              Focusable="False"
                                                              IsChecked="{Binding DataContext.IsPetDamageExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" />
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPetSummary}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Children}" Margin="22,0,0,2">
                                                <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsPetDamageExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="23" Margin="5,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="76" />
                                                                <ColumnDefinition Width="60" /><ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding Icon}" Width="12" Height="12" Margin="0,0,6,0"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <Border Width="10" Height="10" CornerRadius="2" Background="#152F43"
                                                                        BorderBrush="{Binding Color}" BorderThickness="1" Margin="0,0,7,0"
                                                                        VerticalAlignment="Center">
                                                                    <Ellipse Fill="{Binding Color}" Width="4" Height="4" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" Foreground="#B9D1DE" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding DamageText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding DpsText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{Binding ShareText}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#8FAFC1" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Spell tracker workspace -->
            <Grid Grid.Row="2" Grid.RowSpan="3"
                  Visibility="{Binding IsChecked, ElementName=SpellTrackerButton, Converter={StaticResource BooleanToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Background="#62071C2D" BorderBrush="#355B73"
                            BorderThickness="1" CornerRadius="10" Padding="6,5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BuffsSpellTab" Content="BUFFS" GroupName="SpellTrackerSection"
                                         IsChecked="True" Style="{StaticResource ModuleNavigationButton}" />
                            <RadioButton x:Name="DotsSpellTab" Content="DoTs &amp; Debuffs" GroupName="SpellTrackerSection"
                                         Style="{StaticResource ModuleNavigationButton}" MinWidth="158" />
                            <RadioButton x:Name="ControlSpellTab" Content="CONTROL" GroupName="SpellTrackerSection"
                                         Style="{StaticResource ModuleNavigationButton}" />
                        </StackPanel>
                    </Border>
                    <CheckBox Content="Use Modern Spell Icons" Margin="16,0,0,0"
                              VerticalAlignment="Center" Foreground="#C8E0EE" FontSize="12" FontWeight="SemiBold"
                              IsChecked="{Binding UseModernSpellIcons}"
                              ToolTip="When checked, EQDM uses the modern in-game spell icons. Uncheck for classic icon art." />
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16,12"
                        Visibility="{Binding IsChecked, ElementName=BuffsSpellTab, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="54" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="◴" FontSize="24" Foreground="#A98BFF" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="BUFF TRACKER" Style="{StaticResource SectionLabel}" FontSize="15" />
                                    <TextBlock Text="Configure spell timers and expiration alerts" Foreground="#66879D" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Buff Overlay" Padding="12,7" Margin="0,0,8,0" Click="ToggleBuffOverlay_Click" />
                                <Button Content="＋ Add Buff" Padding="13,7" Background="#684CC0" BorderBrush="#A98BFF"
                                        Click="AddBuffRule_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,5,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource BuffInput}" Text="{Binding BuffSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search configured buffs" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <RadioButton Content="All" GroupName="BuffFilter" IsChecked="True" Style="{StaticResource BuffFilter}"
                                             Checked="ShowAllBuffs_Checked" />
                                <RadioButton Content="Enabled" GroupName="BuffFilter" Style="{StaticResource BuffFilter}"
                                             Checked="ShowEnabledBuffs_Checked" />
                                <RadioButton Content="Disabled" GroupName="BuffFilter" Style="{StaticResource BuffFilter}"
                                             Checked="ShowDisabledBuffs_Checked" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Background="#9A0B263A" BorderBrush="#355B73" BorderThickness="1" CornerRadius="8,8,0,0">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" /><ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TRACK" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="SPELL NAME" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="DURATION" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="CAST" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="ALERT" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="DELETE" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="3" ItemsSource="{Binding BuffRulesView}" SelectedItem="{Binding SelectedBuffRule}"
                                 Background="#61071F31" BorderBrush="#355B73" BorderThickness="1,0,1,1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="BuffRow" Background="#360B2638" BorderBrush="#2C4D62" BorderThickness="0,0,0,1" Padding="10,6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="BuffRow" Property="Background" Value="#8A17354D" />
                                                        <Setter TargetName="BuffRow" Property="BorderBrush" Value="#8F72E8" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BuffRow" Property="Background" Value="#6916384D" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" /><ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="120" /><ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource BuffToggle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Click="BuffRuleToggle_Click" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,7,0"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       SnapsToDevicePixels="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding SpellName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TargetSummary}" FontSize="9" Foreground="#66879D" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding CastTimeText, StringFormat={}{0} sec}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A9C3D3" />
                                        <TextBlock Grid.Column="4" Text="{Binding AlertSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B9A7FF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7899AD" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="#39E0CC" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True"><Setter Property="Foreground" Value="#FFBD57" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="31" Height="29" Padding="0"
                                                    Tag="{Binding}" Click="DeleteBuffRule_Click" ToolTip="Delete tracked buff" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="4" Text="Add as many spell timers as you need. Recasting a tracked spell resets its timer."
                                   Foreground="#66879D" FontSize="10" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,12"
                        Visibility="{Binding IsChecked, ElementName=BuffsSpellTab, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="12,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedBuffRule}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="BUFF DETAILS" Style="{StaticResource SectionLabel}" FontSize="15"
                                       HorizontalAlignment="Center" />
                            <Rectangle Height="2" Width="92" Fill="#7658E2" HorizontalAlignment="Center" Margin="0,7,0,14" />
                            <TextBlock Text="Select a buff or click + Add Buff to view details."
                                       Foreground="#66879D" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedBuffRule}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="BUFF DETAILS" Style="{StaticResource SectionLabel}" FontSize="15" />
                                <Rectangle Height="2" Width="92" Fill="#7658E2" HorizontalAlignment="Left" Margin="0,7,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="Spell Name" Style="{StaticResource MetricLabel}" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="52" Height="52" CornerRadius="8" Background="#152F43"
                                            BorderBrush="#416A83" BorderThickness="1" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding SelectedBuffRule.Icon}" Width="44" Height="44"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               SnapsToDevicePixels="True" />
                                    </Border>
                                    <controls:SpellNameSearchBox VerticalAlignment="Center"
                                             Text="{Binding SelectedBuffRule.SpellName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Catalog="{Binding SpellCatalog}"
                                             Tag="{Binding SelectedBuffRule}"
                                             LostFocus="BuffSpellName_LostFocus"
                                             ToolTip="Type to search spell names (not case sensitive). Names are checked against EverQuest Legends spell data." />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedBuffRule.SpellValidationText}" Foreground="#FF8B91"
                                           FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Duration (m:ss)" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedBuffRule.DurationSourceHint}" Foreground="#7FA3B8"
                                                   FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBox Style="{StaticResource BuffInput}" Text="{Binding SelectedBuffRule.DurationText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Cast Time (seconds)" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedBuffRule.CastSourceHint}" Foreground="#7FA3B8"
                                                   FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBox Style="{StaticResource BuffInput}" Text="{Binding SelectedBuffRule.CastTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Reset to spell data" Margin="0,6,0,0" Padding="8,4" HorizontalAlignment="Right"
                                            Click="ResetBuffTimings_Click"
                                            ToolTip="Re-fill cast time and duration from EverQuest spell data" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Track this buff" FontWeight="SemiBold" />
                                    <TextBlock Text="Start or reset the timer when the spell is cast" Foreground="#66879D" FontSize="10" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource BuffToggle}"
                                              IsChecked="{Binding SelectedBuffRule.IsEnabled, Mode=TwoWay}"
                                              Click="BuffRuleToggle_Click" />
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Show in Buff Overlay" FontWeight="SemiBold" />
                                    <TextBlock Text="Display the timer in the separate overlay window" Foreground="#66879D" FontSize="10" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource BuffToggle}"
                                              IsChecked="{Binding SelectedBuffRule.ShowInOverlay, Mode=TwoWay}"
                                              Click="BuffRuleToggle_Click" />
                            </Grid>

                            <Grid Grid.Row="5" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Track Targets" FontWeight="SemiBold" />
                                    <TextBlock Text="Choose self, other players, or both" Foreground="#66879D" FontSize="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Self" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#39E0CC" FontWeight="SemiBold" />
                                    <ToggleButton Style="{StaticResource BuffToggle}"
                                                  IsChecked="{Binding SelectedBuffRule.TrackSelf, Mode=TwoWay}"
                                                  Click="BuffRuleToggle_Click" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Others" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#72B8FF" FontWeight="SemiBold" />
                                    <ToggleButton Style="{StaticResource BuffToggle}"
                                                  IsChecked="{Binding SelectedBuffRule.TrackOthers, Mode=TwoWay}"
                                                  Click="BuffRuleToggle_Click" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="6" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Alert Type" Style="{StaticResource MetricLabel}" Margin="0,0,0,5" />
                                    <ComboBox Style="{StaticResource BuffComboAlert}" ItemsSource="{Binding BuffAlertModes}"
                                              SelectedItem="{Binding SelectedBuffRule.AlertMode, Mode=TwoWay}"
                                              ToolTip="Alert type (sound or text-to-speech)" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Visibility="{Binding SelectedBuffRule.SoundPickerVisibility}">
                                    <TextBlock Text="Sound" Style="{StaticResource MetricLabel}" Margin="0,0,0,5" />
                                    <ComboBox Style="{StaticResource BuffComboAlert}" Width="110"
                                              ItemsSource="{Binding BuffSoundChoices}"
                                              SelectedItem="{Binding SelectedBuffRule.Sound, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="7" Margin="0,14,0,0"
                                        Visibility="{Binding SelectedBuffRule.VoiceTextVisibility}">
                                <TextBlock Text="Voice Text" Style="{StaticResource MetricLabel}" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource BuffInput}" Text="{Binding SelectedBuffRule.VoiceText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Custom text spoken when this alert fires. Leave blank for the default phrase." />
                            </StackPanel>

                            <Border Grid.Row="8" Style="{StaticResource InnerCard}" Margin="0,14,0,0" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LIVE STATUS" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding SelectedBuffRule.StatusText}" FontWeight="SemiBold" Foreground="#2FD8C7" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedBuffRule.RemainingText}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="#A98BFF" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="9" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Content="Test Alert" Click="TestBuffAlert_Click" />
                                <Button Grid.Column="2" Content="Save Buff" Background="#684CC0" BorderBrush="#A98BFF" Click="SaveBuffRules_Click" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    </Grid>
                </Border>

                <controls:SpellRuleEditor Grid.Row="1" Grid.ColumnSpan="3" DataContext="{Binding DotSpellTracker}"
                        OverlayRequested="DotOverlay_Requested"
                        Visibility="{Binding IsChecked, ElementName=DotsSpellTab, Converter={StaticResource BooleanToVisibility}}" />

                <controls:SpellRuleEditor Grid.Row="1" Grid.ColumnSpan="3" DataContext="{Binding ControlSpellTracker}"
                        OverlayRequested="ControlOverlay_Requested"
                        Visibility="{Binding IsChecked, ElementName=ControlSpellTab, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>

            <!-- Session tracker workspace -->
            <Grid Grid.Row="2" Grid.RowSpan="3"
                  Visibility="{Binding IsChecked, ElementName=SessionTrackerButton, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.65*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="SESSIONS" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Current session tracks until EQDM closes" Foreground="#66879D"
                                       FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding SessionHistory.Sessions}"
                                 SelectedItem="{Binding SessionHistory.SelectedSession}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" Background="#6A0E2A3E" BorderBrush="#31566E"
                                                        BorderThickness="1" CornerRadius="12" Padding="12,10">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="#50CFC5" />
                                                        <Setter TargetName="Chrome" Property="Background" Value="#9A103249" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="#A5163A50" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{Binding ExpandGlyph}" Width="28" Height="26" Padding="0"
                                                    Margin="0,0,8,0" FontSize="11" Click="SessionExpand_Click"
                                                    ToolTip="Show or hide loot for this session" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Padding="7,2" CornerRadius="8"
                                                    Visibility="{Binding IsLive, Converter={StaticResource BooleanToVisibility}}"
                                                    Background="#193E3D" BorderBrush="#2B7A70" BorderThickness="1">
                                                <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#91F2E6" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#8BA9BD" FontSize="11" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding CharacterText}" Foreground="#66879D" FontSize="10" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Money earned: " Foreground="#66879D" FontSize="11" />
                                            <TextBlock Text="{Binding MoneyText}" Foreground="#2ED9C7"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding LootExpandVisibility}">
                                            <TextBlock Text="LOOT BY MOB" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Mobs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="1" CornerRadius="8" Padding="8,6"
                                                                Margin="0,0,0,6" Cursor="Hand"
                                                                MouseLeftButtonUp="SessionMobSelect_Click"
                                                                ToolTip="Show loot details on the right">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#4A0C2436" />
                                                                    <Setter Property="BorderBrush" Value="#2A4A5E" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#7A103249" />
                                                                            <Setter Property="BorderBrush" Value="#50CFC5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Summary}" Foreground="#8BA9BD"
                                                                           FontSize="10" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No loot recorded yet" Foreground="#66879D" FontSize="11"
                                                       Margin="2,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Mobs.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,14">
                    <Grid>
                        <!-- Session details (default) -->
                        <Grid DataContext="{Binding SessionHistory.SelectedSession}"
                              Visibility="{Binding DataContext.SessionHistory.SessionDetailsVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="SESSION DETAILS" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#8BA9BD" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding CharacterText}" Foreground="#66879D" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="2" Rows="3" Margin="0,18,0,0">
                                <Border Style="{StaticResource InnerCard}" Padding="14,12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="Level XP gained" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding LevelXpText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="#2ED9C7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="14,12" Margin="8,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Levels gained" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding LevelsText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="#E8F8FF" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="14,12" Margin="0,8,8,8">
                                    <StackPanel>
                                        <TextBlock Text="AA points gained" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding AaPointsText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="#A98BFF" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="14,12" Margin="8,8,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Motes of Potential" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding MotesText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="#F2FAFF" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="14,12" Margin="0,8,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Money earned" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding MoneyText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="#2ED9C7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Padding="14,12" Margin="8,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Deaths" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding DeathsText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="#FF8B8B" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="MOTE BREAKDOWN" Style="{StaticResource SectionLabel}" Margin="2,0,0,8" />
                                    <ListBox Grid.Row="1" ItemsSource="{Binding MoteRows}"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,6" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold"
                                                               Foreground="#A98BFF" Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Mob loot details: latest kill first, then all-kills history -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding DataContext.SessionHistory.MobDetailsVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel DataContext="{Binding SessionHistory.SelectedMob}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="MOB DETAILS" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding Name, TargetNullValue=Select a mob}"
                                                   FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding Summary, TargetNullValue=Click a mob under LOOT BY MOB}"
                                                   Foreground="#8BA9BD" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="Back" Padding="12,6" Margin="0,0,8,0"
                                                Click="SessionMobClear_Click"
                                                ToolTip="Return to session details" />
                                        <Button Content="Open wiki" Padding="12,6"
                                                Click="OpenSessionMobWiki_Click"
                                                ToolTip="Open this mob on the EverQuest Legends wiki" />
                                    </StackPanel>
                                </Grid>

                                <!-- Latest single kill -->
                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,16,0,0"
                                        DataContext="{Binding LatestKill}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="LATEST KILL" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding TimeText}" Foreground="#8BA9BD" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Summary}" Foreground="#8BA9BD" FontSize="12" Margin="0,0,0,10" />
                                        <UniformGrid Columns="4" Margin="0,0,0,12">
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="Coin" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding CoinText}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="#2ED9C7" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="6,0">
                                                <StackPanel>
                                                    <TextBlock Text="Items" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding ItemCountText}" FontSize="18" FontWeight="SemiBold"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="6,0">
                                                <StackPanel>
                                                    <TextBlock Text="Sold" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding SoldText}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="#A98BFF" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Kept / Merged" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0">
                                                        <Run Text="{Binding KeptStoredText, Mode=OneWay}" />
                                                        <Run Text=" / " Foreground="#66879D" />
                                                        <Run Text="{Binding MergedText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <Grid Margin="2,0,2,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Item" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Grid.Column="1" Text="Disposition" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Grid.Column="2" Text="Value / note" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Grid.Column="3" Text="Qty" Style="{StaticResource MetricLabel}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,0,2,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Disposition}" Foreground="#8BA9BD" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#A98BFF"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding CountText}" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Wiki-sourced full drop table for this mob -->
                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MOB'S LOOT TABLE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                        <TextBlock Text="All possible drops from the EverQuest Legends wiki"
                                                   Foreground="#8BA9BD" FontSize="12" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding WikiLootStatus}" Foreground="#66879D" FontSize="11"
                                                   Margin="0,0,0,10" TextWrapping="Wrap"
                                                   Visibility="{Binding WikiLootStatusVisibility}" />
                                        <Grid Margin="2,0,2,6" Visibility="{Binding WikiLootItemsVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Item" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Grid.Column="1" Text="Drop chance" Style="{StaticResource MetricLabel}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding WikiLootItems}"
                                                      Visibility="{Binding WikiLootItemsVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#3A0A1F30" BorderBrush="#2A4A5E" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="110" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="1" Text="{Binding DropChanceText}"
                                                                           Foreground="#A98BFF" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Top" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding StatsStatus}" Foreground="#66879D"
                                                                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding StatsStatusVisibility}" />
                                                            <TextBlock Text="{Binding Stats}" Foreground="#D7EAF5"
                                                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding StatsVisibility}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Aggregate history across all kills of this mob -->
                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="KILL HISTORY" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Summary}" Foreground="#8BA9BD" FontSize="12" Margin="0,0,0,10" />
                                        <UniformGrid Columns="4" Margin="0,0,0,12">
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="Total coin" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding HistoryCoinText}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="#2ED9C7" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="6,0">
                                                <StackPanel>
                                                    <TextBlock Text="Corpses" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding CorpsesText}" FontSize="18" FontWeight="SemiBold"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="6,0">
                                                <StackPanel>
                                                    <TextBlock Text="Items" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="{Binding HistoryItemCountText}" FontSize="18" FontWeight="SemiBold"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Sold / Kept / Merged" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0">
                                                        <Run Text="{Binding HistorySoldText, Mode=OneWay}" Foreground="#A98BFF" />
                                                        <Run Text=" / " Foreground="#66879D" />
                                                        <Run Text="{Binding HistoryKeptStoredText, Mode=OneWay}" />
                                                        <Run Text=" / " Foreground="#66879D" />
                                                        <Run Text="{Binding HistoryMergedText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <TextBlock Text="ALL KILLS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding KillHistory}" Margin="0,0,0,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#3A0A1F30" BorderBrush="#2A4A5E" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                                       Foreground="#8BA9BD" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="8,0" />
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11">
                                                                <Run Text="S " Foreground="#66879D" />
                                                                <Run Text="{Binding SoldText, Mode=OneWay}" Foreground="#A98BFF" />
                                                                <Run Text="  K " Foreground="#66879D" />
                                                                <Run Text="{Binding KeptStoredText, Mode=OneWay}" />
                                                                <Run Text="  M " Foreground="#66879D" />
                                                                <Run Text="{Binding MergedText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="COMBINED ITEMS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                        <Grid Margin="2,0,2,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Item" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Grid.Column="1" Text="Disposition" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Grid.Column="2" Text="Value / note" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Grid.Column="3" Text="Qty" Style="{StaticResource MetricLabel}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding HistoryItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,0,2,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Disposition}" Foreground="#8BA9BD" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="#A98BFF"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding CountText}" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quest tracker workspace -->
            <Grid Grid.Row="2" Grid.RowSpan="3"
                  Visibility="{Binding IsChecked, ElementName=QuestTrackerButton, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.55*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="14,12">
                    <Grid DataContext="{Binding QuestTracker}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="QUEST SEARCH" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CatalogSummary}" Foreground="#66879D" FontSize="10" Margin="0,4,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:QuestNameSearchBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             SuggestionChosen="QuestSuggestionChosen" />
                                <Button Grid.Column="1" Content="Open" Margin="8,0,0,0" Padding="14,7"
                                        Click="QuestOpenSearch_Click" />
                                <Button Grid.Column="2" Content="Refresh list" Margin="8,0,0,0" Padding="12,7"
                                        Click="QuestRefreshCatalog_Click"
                                        ToolTip="Download quest titles from eqlwiki.com" />
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" Foreground="#8BA9BD" FontSize="11" Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="180" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="TRACKED ITEMS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding TrackedItems}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding QuestTitle}" Foreground="#66879D"
                                                                   FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding LastDropText}" Foreground="#2ED9C7"
                                                                   FontSize="10" Margin="0,4,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <CheckBox Content="Alert" IsChecked="{Binding Enabled}"
                                                                      Foreground="#C8DEEA" VerticalAlignment="Center" />
                                                            <ComboBox Style="{StaticResource BuffComboAlert}"
                                                                      ItemsSource="{Binding DataContext.AlertModeChoices, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                      SelectedItem="{Binding AlertMode}" Margin="10,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip="Alert type (sound or text-to-speech)" />
                                                            <ComboBox Style="{StaticResource BuffComboAlert}" Width="110"
                                                                      ItemsSource="{Binding DataContext.SoundChoices, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                      SelectedItem="{Binding Sound}" Margin="8,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="{Binding SoundPickerVisibility}" />
                                                        </StackPanel>
                                                        <TextBox Style="{StaticResource BuffInput}" Margin="0,8,0,0"
                                                                 Text="{Binding VoiceText, UpdateSourceTrigger=LostFocus}"
                                                                 Visibility="{Binding VoiceTextVisibility}"
                                                                 ToolTip="Custom text to speak when this item drops" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Remove" Padding="10,4"
                                                            VerticalAlignment="Top"
                                                            Click="QuestUntrack_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="SUGGESTED ITEMS TO TRACK" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding SuggestedItems}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Content="{Binding TrackButtonText}"
                                                        Padding="10,3" Click="QuestTrackItem_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,14">
                    <Grid DataContext="{Binding QuestTracker}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding EmptyDetailsVisibility}">
                            <TextBlock Text="Select a quest" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Search the wiki list, then open a quest to see NPCs, checklist steps, and trackable items."
                                       Foreground="#8BA9BD" FontSize="12" Margin="0,8,0,0" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="420" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding QuestDetailsVisibility}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="QUEST DETAILS" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding SelectedQuest.Title}" FontSize="22" FontWeight="SemiBold"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Content="Open wiki" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="12,6" Click="QuestOpenWiki_Click" />
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,16,0,0">
                                    <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="Start zone" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding SelectedQuest.StartZone}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="6,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="Quest giver" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding SelectedQuest.QuestGiver}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,6,6,6">
                                        <StackPanel>
                                            <TextBlock Text="Level" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding SelectedQuest.RecommendedLevel}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="6,6,0,6">
                                        <StackPanel>
                                            <TextBlock Text="Classes" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding SelectedQuest.Classes}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,6,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Related zones" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding SelectedQuest.RelatedZones}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="6,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Related NPCs" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding SelectedQuest.RelatedNpcs}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CHECKLIST / STEPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding ChecklistLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                               Foreground="#D7EAF5" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No checklist bullets found on this page. Open the wiki for the full walkthrough."
                                                   Foreground="#66879D" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChecklistLines.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Plane of Sky tracker workspace -->
            <Grid Grid.Row="2" Grid.RowSpan="3"
                  Visibility="{Binding IsChecked, ElementName=SkyTrackerButton, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.45*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="14,12">
                    <Grid DataContext="{Binding SkyTracker}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="ADD SKY REWARD" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CatalogSummary}" Foreground="#66879D" FontSize="10" Margin="0,4,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding ClassNames}"
                                          SelectedItem="{Binding SelectedClass}"
                                          Style="{StaticResource BuffCombo}" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableRewards}"
                                          SelectedItem="{Binding SelectedReward}"
                                          Style="{StaticResource BuffCombo}" Margin="0,0,6,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RewardName}" Foreground="#EDF7FF" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="Refresh" Padding="12,7"
                                        Click="SkyRefreshCatalog_Click"
                                        ToolTip="Download Plane of Sky rewards from eqlwiki.com" />
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" Foreground="#8BA9BD" FontSize="11" Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding EmptyPreviewVisibility}">
                                    <TextBlock Text="Pick a class and reward" Foreground="#8BA9BD"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Stats and required items will appear here."
                                               Foreground="#66879D" FontSize="11" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding PreviewVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="REWARD PREVIEW" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding SelectedReward.RewardName}" FontSize="18"
                                                   FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PreviewQuestSummary}" Foreground="#66879D"
                                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PreviewStats}" Foreground="#D7EAF5"
                                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />

                                        <TextBlock Text="REQUIRED ITEMS" Style="{StaticResource SectionLabel}"
                                                   Margin="0,16,0,8" Foreground="#E0C070" />
                                        <ItemsControl ItemsSource="{Binding PreviewParts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#2A4A5E" BorderThickness="0,0,0,1" Padding="2,8">
                                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center">
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding ItemName, Mode=OneWay}" Foreground="#8EC8E6"
                                                                     FontWeight="SemiBold" />
                                                                <Run Text="{Binding DropSourceText, Mode=OneWay}" Foreground="#C8DEEA" />
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Add selected items" Padding="14,8" Click="SkyAddSelected_Click" />
                            <Button Content="Open wiki" Margin="8,0,0,0" Padding="12,8" Click="SkyOpenWiki_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,14">
                    <Grid DataContext="{Binding SkyTracker}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="YOUR SKY LIST" Style="{StaticResource SectionLabel}" />
                            <Button Content="Plane of Sky page" HorizontalAlignment="Right" Padding="12,4"
                                    Click="SkyOpenPlanePage_Click" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Goals}"
                                 SelectedItem="{Binding SelectedGoal}"
                                 Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="#4A0C2436" BorderBrush="#2A4A5E"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#9C7CFF" />
                                                        <Setter TargetName="Card" Property="Background" Value="#A51A3152" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#A5163A50" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RewardName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#66879D" FontSize="10"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#2ED9C7"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" />
                                        <Button Grid.Column="2" Content="Remove" Padding="10,4"
                                                Click="SkyRemoveGoal_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding EmptyGoalDetailsVisibility}">
                                    <TextBlock Text="Select a reward from your list" Foreground="#8BA9BD"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Tracked ingredients, locations, and alert sounds show here."
                                               Foreground="#66879D" FontSize="11" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding GoalDetailsVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="TRACKED PARTS" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding SelectedGoal.RewardName}" FontSize="18"
                                                   FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedGoal.RewardStats}" Foreground="#D7EAF5"
                                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

                                        <ItemsControl ItemsSource="{Binding SelectedGoal.Parts}" Margin="0,14,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding StatusSummary}" Foreground="#2ED9C7"
                                                                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="Remove" Padding="8,3"
                                                                        VerticalAlignment="Top"
                                                                        Click="SkyRemovePart_Click" />
                                                            </Grid>

                                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                                <TextBlock Text="WHERE STORED" Style="{StaticResource MetricLabel}"
                                                                           Margin="0,0,0,5" />
                                                                <ComboBox Style="{StaticResource BuffComboAlert}" Width="140"
                                                                          HorizontalAlignment="Left"
                                                                          ItemsSource="{Binding DataContext.LocationChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          SelectedValue="{Binding Location, Mode=TwoWay}"
                                                                          SelectedValuePath="Value"
                                                                          DisplayMemberPath="Label"
                                                                          ToolTip="Where you put this item so you can find it later" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                                                <TextBlock Text="ALERT" Style="{StaticResource MetricLabel}"
                                                                           Margin="0,0,0,5" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <CheckBox Content="Alert on loot" IsChecked="{Binding AlertEnabled}"
                                                                              Foreground="#C8DEEA" VerticalAlignment="Center" />
                                                                    <ComboBox Style="{StaticResource BuffComboAlert}"
                                                                              ItemsSource="{Binding DataContext.AlertModeChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              SelectedItem="{Binding AlertMode}"
                                                                              Margin="10,0,0,0" VerticalAlignment="Center"
                                                                              Visibility="{Binding AlertDetailsVisibility}"
                                                                              ToolTip="Alert type (sound or text-to-speech)" />
                                                                    <ComboBox Style="{StaticResource BuffComboAlert}" Width="110"
                                                                              ItemsSource="{Binding DataContext.SoundChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              SelectedItem="{Binding Sound}"
                                                                              Margin="8,0,0,0" VerticalAlignment="Center"
                                                                              Visibility="{Binding SoundPickerVisibility}" />
                                                                    <TextBox Style="{StaticResource BuffInput}" Width="200"
                                                                             Margin="8,0,0,0" VerticalAlignment="Center"
                                                                             Text="{Binding VoiceText, UpdateSourceTrigger=LostFocus}"
                                                                             Visibility="{Binding VoiceTextVisibility}"
                                                                             ToolTip="Custom text spoken when this item drops" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                                                                <TextBlock Text="Found" VerticalAlignment="Center"
                                                                           Foreground="#8BA9BD" Margin="0,0,8,0" />
                                                                <Button Content="-" Width="28" Padding="0,2"
                                                                        Click="SkyFoundMinus_Click" />
                                                                <TextBlock Text="{Binding FoundCount}" Width="28"
                                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                                           FontWeight="Bold" />
                                                                <Button Content="+" Width="28" Padding="0,2"
                                                                        Click="SkyFoundPlus_Click" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Horizontal encounter history -->
            <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="14,10,14,6"
                    Visibility="{Binding IsChecked, ElementName=DpsParserButton, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="ENCOUNTER HISTORY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding EncounterHistory}" SelectedItem="{Binding SelectedHistory}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0,0,0,18">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,4,9,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="HistoryCard" Width="215" Height="76" VerticalAlignment="Top"
                                                    Background="#76102A3E" BorderBrush="#31566E" BorderThickness="1"
                                                    CornerRadius="10" Padding="10,7">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter TargetName="HistoryCard" Property="BorderBrush" Value="#2B7A70" />
                                                    <Setter TargetName="HistoryCard" Property="Background" Value="#193E3D" />
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="HistoryCard" Property="BorderBrush" Value="#9C7CFF" />
                                                    <Setter TargetName="HistoryCard" Property="Background" Value="#A51A3152" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HistoryCard" Property="Background" Value="#A5163A50" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding TargetNames}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="1" Margin="0,4,0,0"><TextBlock Text="{Binding Damage, StringFormat={}{0:N0} damage}" Foreground="#A8C3D4" FontSize="11" /><TextBlock Text="{Binding Dps, StringFormat={}{0:0.0} DPS}" Foreground="#A98BFF" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                                    <Grid Grid.Row="2" Margin="0,4,0,0"><TextBlock Text="{Binding Mode}" Foreground="#2FD8C7" FontSize="10" /><TextBlock Text="{Binding TimeLabel}" Foreground="#64879D" FontSize="10" HorizontalAlignment="Right" /></Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="LOG SOURCE" Foreground="#66879D" FontSize="10" FontWeight="Bold" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding LogFolderText}" Foreground="#58788E" FontSize="10" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Grid>
</Window>
