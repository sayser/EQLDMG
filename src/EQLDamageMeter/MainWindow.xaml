<Window x:Class="EQLDamageMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EQLDamageMeter.Controls"
        Title="EQL Damage Meter" Icon="Assets/EQDM.ico"
        Height="900" Width="1600" MinHeight="760" MinWidth="1180"
        Background="#061522" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#071522" Offset="0" />
            <GradientStop Color="#08263A" Offset="0.46" />
            <GradientStop Color="#081A2B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderGlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#88092236" Offset="0" />
            <GradientStop Color="#780B3349" Offset="0.48" />
            <GradientStop Color="#88092033" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#72082235" Offset="0" />
            <GradientStop Color="#620A3147" Offset="0.48" />
            <GradientStop Color="#72071D30" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DamageGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7957F5" Offset="0" />
            <GradientStop Color="#9B70FF" Offset="0.72" />
            <GradientStop Color="#B49AFF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
            <Setter Property="BorderBrush" Value="#56839C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.32" Color="#001018" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InnerCard" TargetType="Border">
            <Setter Property="Background" Value="#B00C2B40" />
            <Setter Property="BorderBrush" Value="#416A83" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89A9C1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8D4E5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="DamageBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="#071723" />
            <Setter Property="Foreground" Value="{StaticResource DamageGradient}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="9" />
                            <Border x:Name="PART_Track" CornerRadius="9" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                    CornerRadius="9" Opacity="0.93" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InvisibleScrollButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArcaneScrollThumb" TargetType="Thumb">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome" Margin="2" CornerRadius="5" Background="#A5785BE3"
                                BorderBrush="#A99B83FF" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.42" Color="#6F4DE0" /></Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#B52ECFBE" /><Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#78F0E1" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#D29B78FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbChrome" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="#7A061825" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#466D84" BorderThickness="1" CornerRadius="6">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ArcaneScrollThumb}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}" BorderBrush="#466D84" BorderThickness="1" CornerRadius="6">
                                    <Track x:Name="PART_Track" Orientation="Horizontal"
                                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageLeftCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.DecreaseRepeatButton>
                                        <Track.Thumb><Thumb Style="{StaticResource ArcaneScrollThumb}" /></Track.Thumb>
                                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="{x:Static ScrollBar.PageRightCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" /></Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowGradient}">
        <Image Source="Assets/ArcaneBackdrop.png" Stretch="Fill" StretchDirection="Both"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" Opacity="1" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#08000000" Offset="0" />
                    <GradientStop Color="#14031524" Offset="0.52" />
                    <GradientStop Color="#26030D18" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse Width="720" Height="390" Fill="#1239D3C2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="120,-250,0,0">
            <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="620" Height="340" Fill="#157C5CFC" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,80,0">
            <Ellipse.Effect><BlurEffect Radius="100" /></Ellipse.Effect>
        </Ellipse>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="116" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="158" />
                <RowDefinition Height="10" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <!-- Branded command header -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGlow}" BorderBrush="#56839C" BorderThickness="1"
                    CornerRadius="22" Padding="12">
                <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.35" Color="#001018" /></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="76" Height="76" Background="#8A071A28" BorderBrush="#5B879F" BorderThickness="1"
                                CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image Source="Assets/EQDM.png" Width="70" Height="70" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CharacterNameUpper}" FontSize="34" FontWeight="Light" Foreground="#E8F8FF" />
                            <TextBlock Text="EQL  DAMAGE  METER" Foreground="#8FDCD9" FontSize="12" FontWeight="SemiBold" Margin="2,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" Margin="8,5" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border BorderThickness="1" CornerRadius="9" Padding="9,5" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#481E1014" />
                                        <Setter Property="BorderBrush" Value="#A9414D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLogOnline}" Value="True">
                                                <Setter Property="Background" Value="#193E3D" />
                                                <Setter Property="BorderBrush" Value="#2B7A70" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#FF5E70" /><Style.Triggers><DataTrigger Binding="{Binding IsLogOnline}" Value="True"><Setter Property="Fill" Value="#39E0CC" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding MonitorStatusText}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FF6978" /><Style.Triggers><DataTrigger Binding="{Binding IsLogOnline}" Value="True"><Setter Property="Foreground" Value="#91F2E6" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Overlay" Padding="10,6" Margin="0,0,6,0" Click="ToggleOverlay_Click" />
                            <Button Content="Logs" Padding="10,6" Margin="0,0,6,0" Click="ChooseLogs_Click" />
                            <Button Content="Reset" Padding="12,6" Click="ResetEncounter_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="3" Background="#BA081F31" BorderBrush="#4F7891" BorderThickness="1"
                            CornerRadius="16" Padding="8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="1.08*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="1.08*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="1.08*" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="#D8EDFA" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Character" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding CharacterName}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerName, StringFormat={}Server: {0}}" Foreground="#8BA9BD" FontSize="10" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Column="1" Background="#315268" Margin="0,9" />

                            <Grid Grid.Column="2" Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="◎" FontSize="36" FontWeight="Light" Foreground="#C8E6F5" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Mode" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding ModeText}" Style="{StaticResource MetricValue}" Foreground="#2ED9C7" /></StackPanel>
                            </Grid>
                            <Border Grid.Column="3" Background="#315268" Margin="0,9" />

                            <Grid Grid.Column="4" Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="◷" FontSize="34" FontWeight="Light" Foreground="#C8E6F5" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Duration" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding EncounterTime}" Style="{StaticResource MetricValue}" Foreground="#F2FAFF" /></StackPanel>
                            </Grid>
                            <Border Grid.Column="5" Background="#315268" Margin="0,9" />

                            <Grid Grid.Column="6" Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="47" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Viewbox Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Canvas Width="36" Height="36">
                                        <Path Data="M5,29 L5,7 M5,29 L31,29" Stroke="#9A78FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Polyline Points="8,25 14,18 19,21 29,9" Stroke="#9A78FF" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="23.5" Width="3" Height="3" Fill="#C8B8FF" />
                                        <Ellipse Canvas.Left="12.5" Canvas.Top="16.5" Width="3" Height="3" Fill="#C8B8FF" />
                                        <Ellipse Canvas.Left="17.5" Canvas.Top="19.5" Width="3" Height="3" Fill="#C8B8FF" />
                                        <Ellipse Canvas.Left="27.5" Canvas.Top="7.5" Width="3" Height="3" Fill="#C8B8FF" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Encounter DPS" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding EncounterDps}" Style="{StaticResource MetricValue}" Foreground="#9B70FF" /></StackPanel>
                            </Grid>
                            <Border Grid.Column="7" Background="#315268" Margin="0,9" />

                            <Grid Grid.Column="8" Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="47" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Viewbox Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Canvas Width="36" Height="36">
                                        <Path Data="M5,27 A13,13 0 0 1 31,27" Stroke="#29D3C2" StrokeThickness="2.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M9,22 L7,21 M14,16 L13,14 M22,16 L23,14 M27,22 L29,21" Stroke="#76E8DC" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Line X1="18" Y1="27" X2="26" Y2="17" Stroke="#29D3C2" StrokeThickness="2.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Canvas.Left="15.5" Canvas.Top="24.5" Width="5" Height="5" Fill="#76E8DC" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Current DPS" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding CurrentDps}" Style="{StaticResource MetricValue}" Foreground="#29D3C2" /></StackPanel>
                            </Grid>
                            <Border Grid.Column="9" Background="#315268" Margin="0,9" />

                            <Grid Grid.Column="10" Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="47" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#x2694;" FontSize="31" Foreground="#D8EDFA" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Total Damage" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding CharacterDamage}" Style="{StaticResource MetricValue}" Foreground="#F2FAFF" /></StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚔" FontSize="18" Foreground="#A7C8DA" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="DPS RANKING" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="Current encounter" Foreground="#66879D" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Content="Combine pet DPS with owner"
                                      IsChecked="{Binding CombinePetDamage, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Foreground="#C8DEEA" FontSize="11" Margin="0,0,4,0"
                                      ToolTip="Combine regular and charmed pet damage into the owner's DPS row" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedCombatant}"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" Background="#6A0E2A3E" BorderBrush="#31566E" BorderThickness="1"
                                                        CornerRadius="12" Padding="8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="#50CFC5" />
                                                        <Setter TargetName="Chrome" Property="Background" Value="#9A103249" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#A5163A50" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="66">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" /><ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hits, StringFormat={}{0} hits}" FontSize="11" Foreground="#91B0C4" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Style="{StaticResource DamageBarStyle}" Height="20"
                                                     Value="{Binding Damage}" Maximum="{Binding DataContext.MaxDamage, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     VerticalAlignment="Center" Margin="8,0,18,0" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DamageText}" FontSize="19" FontWeight="SemiBold" />
                                            <TextBlock Text="DAMAGE" FontSize="9" Foreground="#86A6BA" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DpsText}" FontSize="24" FontWeight="SemiBold" Foreground="#AB8EFF" />
                                            <TextBlock Text="DPS" FontSize="9" Foreground="#86A6BA" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Analysis inspector -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" /><RowDefinition Height="58" />
                            <RowDefinition Height="200" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Margin="2,2,2,0" CornerRadius="17,17,0,0" Background="#9A071C2D"
                                BorderBrush="#527B94" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border CornerRadius="16,0,0,0" BorderBrush="#355B73" BorderThickness="0,0,1,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#32102B40" /><Style.Triggers><DataTrigger Binding="{Binding OffenseVisibility}" Value="Visible"><Setter Property="Background" Value="#C7684EC9" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Button Content="Offense" Click="ShowOffense_Click" Background="Transparent" BorderThickness="0" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#355B73" BorderThickness="0,0,1,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#32102B40" /><Style.Triggers><DataTrigger Binding="{Binding DefenseVisibility}" Value="Visible"><Setter Property="Background" Value="#C7684EC9" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Button Content="Defense" Click="ShowDefense_Click" Background="Transparent" BorderThickness="0" />
                                </Border>
                                <Border Grid.Column="2" CornerRadius="0,16,0,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#32102B40" /><Style.Triggers><DataTrigger Binding="{Binding HealingVisibility}" Value="Visible"><Setter Property="Background" Value="#B8146B69" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Button Content="Healing" Click="ShowHealing_Click" Background="Transparent" BorderThickness="0" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="15,7,15,2">
                            <StackPanel>
                                <TextBlock Text="DAMAGE BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10" Visibility="{Binding OffenseVisibility}" />
                                <TextBlock Text="DEFENSE BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10" Visibility="{Binding DefenseVisibility}" />
                                <TextBlock Text="HEALING BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10" Visibility="{Binding HealingVisibility}" />
                                <TextBlock Text="{Binding SelectedName}" FontSize="17" FontWeight="SemiBold" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Offense metrics -->
                        <Grid Grid.Row="2" Margin="15,0,15,8" Visibility="{Binding OffenseVisibility}">
                            <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="HITS" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.Hits}" FontSize="16" FontWeight="Bold" /></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="MISSED" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.Misses}" FontSize="16" FontWeight="Bold" Foreground="#FFBD57" /></StackPanel></Border>
                                <Border Grid.Column="4" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="CRIT %" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.CriticalRateText}" FontSize="16" FontWeight="Bold" Foreground="#FFBD57" /></StackPanel></Border>
                                <Border Grid.Column="6" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="SPELL CRIT %" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.SpellCriticalRateText}" FontSize="16" FontWeight="Bold" Foreground="#2FD8C7" /></StackPanel></Border>
                                <Border Grid.Column="8" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="RESISTED" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.SpellResists}" FontSize="16" FontWeight="Bold" Foreground="#FF6C91" /></StackPanel></Border>
                                <Border Grid.Column="10" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="FIZZLED" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.SpellFizzles}" FontSize="16" FontWeight="Bold" Foreground="#A985FF" /></StackPanel></Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <controls:DonutChart Width="184" Height="145" ItemsSource="{Binding SelectedAbilities}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            </Grid>
                        </Grid>

                        <!-- Healing metrics -->
                        <Grid Grid.Row="2" Margin="15,0,15,8" Visibility="{Binding HealingVisibility}">
                            <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="HEALING" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.HealingText}" FontSize="16" FontWeight="Bold" Foreground="#2FD8C7" /></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="HPS" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.HpsText}" FontSize="16" FontWeight="Bold" Foreground="#A985FF" /></StackPanel></Border>
                                <Border Grid.Column="4" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="DIRECT" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.DirectHeals}" FontSize="16" FontWeight="Bold" /></StackPanel></Border>
                                <Border Grid.Column="6" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="HOT TICKS" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.HealOverTimeTicks}" FontSize="16" FontWeight="Bold" /></StackPanel></Border>
                                <Border Grid.Column="8" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="HEAL CRIT %" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.HealingCriticalRateText}" FontSize="16" FontWeight="Bold" Foreground="#FFBD57" /></StackPanel></Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <controls:DonutChart Width="184" Height="145" ItemsSource="{Binding SelectedAbilities}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            </Grid>
                        </Grid>

                        <!-- Defense charts -->
                        <Grid Grid.Row="2" Grid.RowSpan="2" Margin="15,4,15,8" Visibility="{Binding DefenseVisibility}">
                            <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="DAMAGE TAKEN" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.DamageTakenText}" FontSize="16" FontWeight="Bold" /></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="AVOIDANCE" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.AvoidanceRateText}" FontSize="16" FontWeight="Bold" Foreground="#2FD8C7" /></StackPanel></Border>
                                <Border Grid.Column="4" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="RESISTS" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.IncomingSpellResists}" FontSize="16" FontWeight="Bold" Foreground="#A985FF" /></StackPanel></Border>
                                <Border Grid.Column="6" Style="{StaticResource InnerCard}" Padding="8,5"><StackPanel><TextBlock Text="ABSORBED" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding SelectedCombatant.Absorbed}" FontSize="16" FontWeight="Bold" /></StackPanel></Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="MITIGATION OUTCOMES" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <Grid Grid.Row="2" Margin="0,3,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <controls:DonutChart Width="145" Height="120" ItemsSource="{Binding SelectedMitigations}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ListBox Grid.Column="1" ItemsSource="{Binding SelectedMitigations}" Background="Transparent" BorderThickness="0" Padding="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><Ellipse Fill="{Binding Color}" Width="8" Height="8" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding DamageText}" HorizontalAlignment="Right" TextAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding ShareText}" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#96B7CA" /></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Column="1" Text="No mitigation outcomes recorded" Foreground="#7899AD" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedMitigations.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="3" Background="#31546A" />
                            <TextBlock Grid.Row="4" Text="INCOMING DAMAGE BY ABILITY" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <Grid Grid.Row="5" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <controls:DonutChart Width="145" Height="120" ItemsSource="{Binding SelectedIncomingAbilities}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ListBox Grid.Column="1" ItemsSource="{Binding SelectedIncomingAbilities}" Background="Transparent" BorderThickness="0" Padding="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><Ellipse Fill="{Binding Color}" Width="8" Height="8" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding DamageText}" HorizontalAlignment="Right" TextAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding ShareText}" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#96B7CA" /></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Column="1" Text="No incoming damage recorded" Foreground="#7899AD" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIncomingAbilities.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- Ability breakdown table -->
                        <Grid Grid.Row="3" Margin="15,-8,15,6">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding DefenseVisibility}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="ABILITY BREAKDOWN" Style="{StaticResource SectionLabel}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="1" Background="#9A0B263A" BorderBrush="#355B73" BorderThickness="1" CornerRadius="8,8,0,0" TextElement.FontSize="9">
                                <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="Ability" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Damage" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding OffenseVisibility}" /><TextBlock Grid.Column="1" Text="Healing" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HealingVisibility}" /><TextBlock Grid.Column="2" Text="DPS" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding OffenseVisibility}" /><TextBlock Grid.Column="2" Text="HPS" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HealingVisibility}" /><TextBlock Grid.Column="3" Text="% of Total" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            </Border>
                            <ListBox Grid.Row="2" ItemsSource="{Binding SelectedAbilities}" Background="#71071F31" BorderBrush="#355B73" BorderThickness="1,0,1,1" Padding="4" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Height="26" Margin="5,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▶" Width="14" Foreground="#A98BFF" VerticalAlignment="Center">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsPetSummary}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding DataContext.IsPetDamageExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Text" Value="▼" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Width="16" Height="16" CornerRadius="4" Background="#152F43" BorderBrush="{Binding Color}" BorderThickness="1" Margin="0,0,7,0"><Ellipse Fill="{Binding Color}" Width="6" Height="6" /></Border>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8F4FF" /><Style.Triggers><DataTrigger Binding="{Binding IsPetSummary}" Value="True"><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#D8CCFF" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DamageText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="{Binding DpsText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <Grid Grid.Column="3" Margin="10,0,0,0"><TextBlock Text="{Binding ShareText}" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#A7C2D3" /><ProgressBar Value="{Binding Share}" Maximum="100" Width="42" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#132B3E" Foreground="#9875FF" /></Grid>
                                                <ToggleButton Grid.ColumnSpan="4" Background="Transparent" BorderThickness="0"
                                                              Focusable="False"
                                                              IsChecked="{Binding DataContext.IsPetDamageExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" />
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPetSummary}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Children}" Margin="22,0,0,2">
                                                <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsPetDamageExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                <ItemsControl.ItemTemplate><DataTemplate><Grid Height="23" Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="60" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="12" Height="12" CornerRadius="3" Background="#152F43" BorderBrush="{Binding Color}" BorderThickness="1" Margin="0,0,7,0"><Ellipse Fill="{Binding Color}" Width="4" Height="4" /></Border><TextBlock Text="{Binding Name}" Foreground="#B9D1DE" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding DamageText}" HorizontalAlignment="Right" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding DpsText}" HorizontalAlignment="Right" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding ShareText}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#8FAFC1" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Horizontal encounter history -->
            <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="14,10,14,6">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="ENCOUNTER HISTORY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="Choose a completed fight · Live returns to the current encounter" Foreground="#66879D"
                                   FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding EncounterHistory}" SelectedItem="{Binding SelectedHistory}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0,0,0,18">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,4,9,0" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="HistoryCard" Width="215" Height="76" VerticalAlignment="Top" Background="#76102A3E" BorderBrush="#31566E" BorderThickness="1" CornerRadius="10" Padding="10,7"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryCard" Property="BorderBrush" Value="#9C7CFF" /><Setter TargetName="HistoryCard" Property="Background" Value="#A51A3152" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryCard" Property="Background" Value="#A5163A50" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding TargetNames}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="1" Margin="0,4,0,0"><TextBlock Text="{Binding Damage, StringFormat={}{0:N0} damage}" Foreground="#A8C3D4" FontSize="11" /><TextBlock Text="{Binding Dps, StringFormat={}{0:0.0} DPS}" Foreground="#A98BFF" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                                    <Grid Grid.Row="2" Margin="0,4,0,0"><TextBlock Text="{Binding Mode}" Foreground="#2FD8C7" FontSize="10" /><TextBlock Text="{Binding StartedAt, StringFormat={}{0:t}}" Foreground="#64879D" FontSize="10" HorizontalAlignment="Right" /></Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="LOG SOURCE" Foreground="#66879D" FontSize="10" FontWeight="Bold" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding LogFolderText}" Foreground="#58788E" FontSize="10" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Grid>
</Window>
