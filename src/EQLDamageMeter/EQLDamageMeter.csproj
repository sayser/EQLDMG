<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\EQDM.ico</ApplicationIcon>
    <Version>1.2.7</Version>
    <AssemblyVersion>1.2.7.0</AssemblyVersion>
    <FileVersion>1.2.7.0</FileVersion>
    <Product>EQDM</Product>
    <AssemblyTitle>EQDM</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\EQDM.ico" />
    <Resource Include="Assets\EQDM.png" />
    <Resource Include="Assets\ArcaneBackdrop.png" />
  </ItemGroup>

</Project>
