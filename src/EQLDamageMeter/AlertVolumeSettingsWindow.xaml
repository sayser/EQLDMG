<Window x:Class="EQLDamageMeter.AlertVolumeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts &amp; Voice" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF071624">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8BA9BD" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DialogInput" TargetType="TextBox">
            <Setter Property="Background" Value="#9A0B263A" />
            <Setter Property="Foreground" Value="#E8F5FC" />
            <Setter Property="BorderBrush" Value="#42677F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="#E8F5FC" />
            <Setter Property="SelectionBrush" Value="#684CC0" />
        </Style>
        <ControlTemplate x:Key="DialogComboToggle" TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    CornerRadius="4">
                <Path Data="M 0,0 L 7,7 L 14,0" Stroke="#A9C3D3" StrokeThickness="1.6"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      Width="12" Height="7" Stretch="Fill" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A93AB" />
                    <Setter TargetName="Chrome" Property="Background" Value="#B0122E44" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#A98BFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="DialogCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDF7FF" />
            <Setter Property="Background" Value="#A0092235" />
            <Setter Property="BorderBrush" Value="#42677F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Foreground="#EDF7FF" FontWeight="SemiBold" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EDF7FF" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#3A5A72" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#684CC0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DialogComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press" />
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#122636" BorderBrush="#5A7F96" BorderThickness="1"
                                        CornerRadius="4" SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#32102B40" />
            <Setter Property="BorderBrush" Value="#2A4A5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Border Background="#A0092235" BorderBrush="#355B73" BorderThickness="1" CornerRadius="12" Margin="8" Padding="14">
        <StackPanel>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="ALERTS &amp; VOICE" FontWeight="Bold" FontSize="13" Foreground="#E8F5FC" />
                <TextBlock Text="Spoken alerts use the voice below. Muting volume silences both sounds and speech."
                           Foreground="#7FA3B8" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="SPOKEN ALERTS" FontWeight="SemiBold" Foreground="#E8F5FC" FontSize="12" />
                    <TextBlock Text="Alerts speak when you set their output to Voice in the Alerts tab — there is no switch here."
                               Foreground="#7FA3B8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />

                    <TextBlock Text="Voice engine" Style="{StaticResource DialogLabel}" />
                    <ComboBox Style="{StaticResource DialogCombo}" Margin="0,4,0,8"
                              ItemsSource="{Binding Engines}"
                              SelectedItem="{Binding SelectedEngine}" />

                    <TextBlock Text="Voice" Style="{StaticResource DialogLabel}" />
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource DialogCombo}"
                                  ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" />
                        <Button Grid.Column="1" Content="▶ PREVIEW" Padding="12,6" Margin="8,0,0,0"
                                Foreground="#E8B84A" Click="Preview_Click"
                                ToolTip="Speak a sample with the selected voice" />
                    </Grid>

                    <Button Content="{Binding DownloadButtonText}" Padding="12,7" HorizontalAlignment="Left"
                            Click="Download_Click"
                            Visibility="{Binding ShowDownload, Converter={StaticResource BooleanToVisibility}}"
                            IsEnabled="{Binding CanDownload}" />
                    <TextBlock Text="{Binding VoiceStatus}" Foreground="#8BA9BD" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="VOLUME" Style="{StaticResource DialogLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VolumeText}" HorizontalAlignment="Right"
                                   Foreground="#C8E0EE" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                    <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}" TickFrequency="5"
                            IsSnapToTickEnabled="True" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="BOSS DEFEAT MUSIC" FontWeight="SemiBold" Foreground="#E8F5FC" FontSize="12" />
                    <TextBlock Text="Plays only after defeat of named mobs, bosses, and raid bosses"
                               Foreground="#7FA3B8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <CheckBox Content="Play a sound when a named or boss is slain"
                              IsChecked="{Binding BossDefeatSoundEnabled}" Foreground="#C8DEEA" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BossDefeatSoundPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogInput}" />
                        <Button Grid.Column="1" Content="Browse…" Padding="12,6" Margin="8,0,0,0"
                                Click="BrowseBossSound_Click" />
                        <Button Grid.Column="2" Content="Test" Padding="12,6" Margin="8,0,0,0"
                                Click="TestBossSound_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                <Button Content="Cancel" Padding="14,7" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Save" Padding="16,7" Background="#684CC0" BorderBrush="#A98BFF"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
