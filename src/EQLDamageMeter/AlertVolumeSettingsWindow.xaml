<Window x:Class="EQLDamageMeter.AlertVolumeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert Volume" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF071624">
    <Window.Resources>
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8BA9BD" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#32102B40" />
            <Setter Property="BorderBrush" Value="#2A4A5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Border Background="#A0092235" BorderBrush="#355B73" BorderThickness="1" CornerRadius="12" Margin="8" Padding="14">
        <StackPanel>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="ALERT VOLUME" FontWeight="Bold" FontSize="13" Foreground="#E8F5FC" />
                <TextBlock Text="Controls volume for all alert sounds and text-to-speech across EQDM."
                           Foreground="#7FA3B8" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="VOLUME" Style="{StaticResource DialogLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VolumeText}" HorizontalAlignment="Right"
                                   Foreground="#C8E0EE" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                    <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}" TickFrequency="5"
                            IsSnapToTickEnabled="True" Margin="0,6,0,0" />
                    <TextBlock Text="0% is silent. This setting applies to buff, spell, quest, and loot alerts."
                               Foreground="#66879D" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                <Button Content="Test Alert" Padding="14,7" Margin="0,0,8,0" Click="TestAlert_Click"
                        ToolTip="Play a sample alert at the current volume" />
                <Button Content="Cancel" Padding="14,7" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Save" Padding="16,7" Background="#684CC0" BorderBrush="#A98BFF"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
