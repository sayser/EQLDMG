<Window x:Class="EQLDamageMeter.SpellEffectOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EQLDamageMeter.Models"
        Title="EQDM Spell Overlay" Width="430" Height="300" MinWidth="330" MinHeight="100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" PreviewMouseLeftButtonDown="Overlay_PreviewMouseLeftButtonDown">
    <Border Background="#E0071928" BorderBrush="#6C8CA2" BorderThickness="1" CornerRadius="13" Padding="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x25F4;" FontSize="18" Foreground="#A98BFF" Margin="2,0,8,0" />
                    <TextBlock Text="{Binding HeaderTitle}" FontWeight="Bold" Foreground="#E8F5FC" />
                </StackPanel>
                <Button Content="&#x00D7;" HorizontalAlignment="Right" Width="25" Height="25" Padding="0" FontSize="14"
                        ToolTip="Close overlay" Click="Close_Click" />
            </Grid>
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding OverlayEntries}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Focusable" Value="False" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="EffectRow" BorderThickness="1" CornerRadius="9" Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SpellName}" FontWeight="SemiBold" Foreground="#F0F8FF" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TypeLabel" Text="{Binding EffectTypeLabel}" FontSize="10" FontWeight="Bold" Foreground="#FF9B62" />
                                            <TextBlock Text="  ·  " FontSize="10" Foreground="#526F83" />
                                            <TextBlock Text="{Binding TargetName}" FontSize="10" Foreground="#A9C3D3" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="  ·  " FontSize="10" Foreground="#526F83" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#7899AD" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="RemainingTimer" Grid.Column="2" Text="{Binding RemainingText}" FontSize="20" FontWeight="Bold"
                                               Foreground="#FF9B62" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#D12D211A" /><Setter Property="BorderBrush" Value="#D87539" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Category}" Value="{x:Static models:SpellTrackerCategory.Control}">
                                                <Setter Property="Background" Value="#D1241938" /><Setter Property="BorderBrush" Value="#8F72E8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFBD57" /><Setter Property="Background" Value="#E13D2D25" />
                                                <DataTrigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.48" To="1" Duration="0:0:0.42" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse" /></DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FF5C70" />
                                                <Setter Property="Background" Value="#E13D1E32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:SpellTrackerCategory.Control}">
                                    <Setter TargetName="TypeLabel" Property="Foreground" Value="#C4A4FF" />
                                    <Setter TargetName="RemainingTimer" Property="Foreground" Value="#C4A4FF" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No tracked spell effects are currently active." Foreground="#7899AD"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding OverlayEntries.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>
