<Window x:Class="EQLDamageMeter.SkyNeededItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Needed Sky items" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FF071624"
        MinHeight="360" MinWidth="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <Border Background="#A0092235" BorderBrush="#355B73" BorderThickness="1" CornerRadius="12"
            Margin="8" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="NEEDED SKY ITEMS" FontWeight="Bold" FontSize="14" Foreground="#E8F5FC" />
                <TextBlock x:Name="SubtitleText" Foreground="#7FA3B8" FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding IslandName}" FontSize="13" FontWeight="Bold"
                                           Foreground="#2FD8C7" Margin="0,0,0,6" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Bosses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8,0,0,8">
                                                <TextBlock Text="{Binding BossName}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#E0C070"
                                                           Margin="0,0,0,4"
                                                           Visibility="{Binding HasBoss, Converter={StaticResource BooleanToVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#33081420" BorderBrush="#2A4A5E"
                                                                    BorderThickness="1" CornerRadius="8"
                                                                    Padding="10,7" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding ItemName}"
                                                                                   FontSize="13" FontWeight="SemiBold"
                                                                                   Foreground="#2FD8C7"
                                                                                   TextDecorations="Underline"
                                                                                   Cursor="Hand"
                                                                                   MouseLeftButtonUp="OpenItemWiki_Click" />
                                                                        <TextBlock Text="{Binding ClassesText}"
                                                                                   FontSize="11" Foreground="#8BA9BD"
                                                                                   Margin="0,2,0,0"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding RemainingText}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="#F5D56A"
                                                                               VerticalAlignment="Center"
                                                                               Margin="10,0,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Padding="16,6"
                    Margin="0,12,0,0" IsCancel="True" Click="Close_Click" />
        </Grid>
    </Border>
</Window>
