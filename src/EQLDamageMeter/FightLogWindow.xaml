<Window x:Class="EQLDamageMeter.FightLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EQLDamageMeter.Controls"
        Title="Fight Logs" Height="640" Width="920"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FF071624"
        MinHeight="420" MinWidth="640">
    <Window.Resources>
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8BA9BD" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Background="#A0092235" BorderBrush="#355B73" BorderThickness="1" CornerRadius="12" Margin="8" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="FIGHT LOGS" FontWeight="Bold" FontSize="14" Foreground="#E8F5FC" />
                    <TextBlock x:Name="SubtitleText" Foreground="#7FA3B8" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,3" CornerRadius="6" Background="#22102B40" BorderBrush="#2A4A5E" BorderThickness="1" Margin="0,0,6,0">
                        <TextBlock FontSize="10" Foreground="#A9C3D3">
                            <Run Foreground="#3EE8D8" FontWeight="SemiBold" Text="{}{ability}" />
                            <Run Text="  " />
                            <Run Foreground="#C9A0FF" FontWeight="SemiBold" FontStyle="Italic" FontFamily="Georgia" Text="{}{spell}" />
                            <Run Text="  " />
                            <Run Foreground="#FFD06A" FontWeight="SemiBold" Text="damage" />
                            <Run Text="  " />
                            <Run Foreground="#FF6C91" FontWeight="SemiBold" Text="crit" />
                            <Run Text="  " />
                            <Run Foreground="#FF9A7A" FontWeight="SemiBold" Text="enemy" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#280A1E2C" BorderBrush="#2A4A5E" BorderThickness="1"
                    CornerRadius="8" Padding="4">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAltRow}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#140A1E2C" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#2A163A50" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:FightLogLineControl Segments="{Binding Segments}"
                                                         TextWrapping="Wrap" FontSize="13"
                                                         LineHeight="20" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Close" Padding="16,7" IsCancel="True" IsDefault="True" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
