<UserControl x:Class="EQLDamageMeter.Controls.SkyTrackerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SkyTrackCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8DEEA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="#33081420" BorderBrush="#56839C" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M1,7 L5,11 L13,2" Stroke="#082018"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" Stretch="Uniform" Margin="2" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2FD8C7" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7FF0D2" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2FD8C7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SkyStatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="#2B5A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                    <Setter Property="Background" Value="#2B5A8A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReady}" Value="True">
                    <Setter Property="Background" Value="#C9A227" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="#1F6B5A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SkyLocationBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="#2A4A6A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowLocation}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocationLabel}" Value="Equipment">
                    <Setter Property="Background" Value="#2A4A6A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocationLabel}" Value="Bank">
                    <Setter Property="Background" Value="#4A3A6A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocationLabel}" Value="Hoard">
                    <Setter Property="Background" Value="#6A4A2A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocationLabel}" Value="Currencies">
                    <Setter Property="Background" Value="#1A5A4A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocationLabel}" Value="Other">
                    <Setter Property="Background" Value="#3A4A5A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource GlassCard}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Foreground="#C8DEEA" FontSize="13"
                               VerticalAlignment="Center">
                        <Run Text="!" FontSize="22" FontWeight="Bold" Foreground="#E53935" />
                        <Run Text=" In game, type " />
                        <Run Text="/out inventory" FontFamily="Consolas" FontWeight="Bold" Foreground="#2FD8C7" />
                        <Run Text=", then click " />
                        <Run Text="Scan dump" FontWeight="Bold" Foreground="#2FD8C7" />
                        <Run Text=" to sync bags, bank, and Hoard." />
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" Foreground="#8BA9BD" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Button Content="Scan dump" Padding="12,6" Click="ScanInventoryDump_Click"
                            ToolTip="Scan Character_server-Inventory.txt next to the Logs folder after you type /out inventory in game" />
                    <Button Content="{Binding MissingTrackButtonText}" Padding="12,6" Margin="8,0,0,0"
                            Click="ToggleMissingTracking_Click"
                            ToolTip="Track every still-missing required item on IN PROGRESS Sky quests. Click again to stop all item tracking." />
                    <Button Content="Plane of Sky page" Padding="12,6" Margin="8,0,0,0"
                            Click="OpenPlanePage_Click"
                            ToolTip="Open the Plane of Sky wiki page" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.55*" />
            </Grid.ColumnDefinitions>

        <Border Style="{DynamicResource GlassCard}" Padding="12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="CLASS" Style="{DynamicResource SectionLabel}" />
                    <TextBlock Text="{Binding CatalogSummary}" Foreground="#66879D"
                               FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding ClassRows}"
                         SelectedItem="{Binding SelectedClassRow}"
                         Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="#4A0C2436" BorderBrush="#2A4A5E"
                                                BorderThickness="1" CornerRadius="10" Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#2FD8C7" />
                                                <Setter TargetName="Card" Property="Background" Value="#4020A090" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#A5163A50" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="#33081420"
                                        BorderBrush="#355B73" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="14"
                                               Foreground="#2FD8C7" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold"
                                               Foreground="#E8F8FF" FontSize="13" />
                                    <TextBlock Text="{Binding QuestGiver}" Foreground="#7FDCD4" FontSize="11"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="!" FontSize="22" FontWeight="Bold"
                                           Foreground="#F08A24" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" ToolTip="Ready to turn in">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasReadyTurnIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource GlassCard}" Padding="12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedClassTitle}" Style="{DynamicResource SectionLabel}"
                               FontSize="14" />
                    <TextBlock Text="{Binding SelectedQuestGiver}" Foreground="#7FDCD4" FontSize="13"
                               Margin="0,4,0,10" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding QuestRows}"
                         SelectedItem="{Binding SelectedQuestRow}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="#4A0C2436" BorderBrush="#2A4A5E"
                                                BorderThickness="1" CornerRadius="10" Padding="14,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#2FD8C7" />
                                                <Setter TargetName="Card" Property="Background" Value="#4020A090" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#A5163A50" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E8F8FF"
                                           FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource SkyStatusBadge}">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#B8D4F0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Foreground" Value="#1A1408" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground" Value="#7FF0D2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="4" Style="{DynamicResource GlassCard}" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="REWARD" Style="{DynamicResource SectionLabel}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedReward.RewardName}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#2FD8C7" TextWrapping="Wrap" Cursor="Hand"
                                   TextDecorations="Underline" ToolTip="Open wiki"
                                   MouseLeftButtonUp="OpenRewardWiki_Click" />
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding PreviewQuestName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E0C070" TextWrapping="Wrap"
                                       Visibility="{Binding PreviewQuestNameVisibility}" />
                            <TextBlock Text="  ·  " FontSize="13" Foreground="#5A7388"
                                       Visibility="{Binding PreviewQuestLeadSeparatorVisibility}" />
                            <TextBlock Text="{Binding PreviewSayCommand}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#2FD8C7" TextWrapping="Wrap"
                                       Visibility="{Binding PreviewSayCommandVisibility}" />
                            <TextBlock Text="  to  " FontSize="13" Foreground="#8BA9BD"
                                       Visibility="{Binding PreviewSayToVisibility}" />
                            <TextBlock Text="{Binding PreviewQuestNpc}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#C4A5FF" TextWrapping="Wrap"
                                       Visibility="{Binding PreviewQuestNpcVisibility}" />
                        </WrapPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="+LEVEL" Foreground="#8BA9BD" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                    Height="18" VerticalAlignment="Center"
                                    Value="{Binding UpgradeTier}" Foreground="#2FD8C7" />
                            <TextBlock Grid.Column="2" Text="{Binding UpgradeTierLabel}" Foreground="#2FD8C7"
                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Width="28" />
                        </Grid>

                        <Border Style="{DynamicResource InnerCard}" Padding="12,10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="STATS" Style="{DynamicResource SectionLabel}" />
                                <TextBlock Text="{Binding DisplayStats}" Foreground="#D7EAF5"
                                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                           FontFamily="Consolas" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="REQUIRED ITEMS" Style="{DynamicResource SectionLabel}"
                                   Margin="0,16,0,10" Foreground="#E0C070" FontSize="14" />
                         <ItemsControl ItemsSource="{Binding SelectedParts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#4A0C2436" BorderBrush="#2A4A5E" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="·" />
                                                        <Setter Property="Foreground" Value="#66879D" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasEnough}" Value="True">
                                                                <Setter Property="Text" Value="✓" />
                                                                <Setter Property="Foreground" Value="#E0C070" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                <Setter Property="Text" Value="×" />
                                                                <Setter Property="Foreground" Value="#E08A5A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       Foreground="#8EC8E6" FontSize="15" TextWrapping="Wrap"
                                                       Cursor="Hand" TextDecorations="Underline"
                                                       VerticalAlignment="Center"
                                                       MouseLeftButtonUp="OpenItemWiki_Click" />
                                            <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Foreground="#A8C8DC"
                                                       FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                            <Border Grid.Column="3" Style="{StaticResource SkyLocationBadge}">
                                                <TextBlock Text="{Binding LocationLabel}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8EC8E6" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LocationLabel}" Value="Bank">
                                                                    <Setter Property="Foreground" Value="#C4B0F0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LocationLabel}" Value="Hoard">
                                                                    <Setter Property="Foreground" Value="#E0C070" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LocationLabel}" Value="Currencies">
                                                                    <Setter Property="Foreground" Value="#7FDCD4" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LocationLabel}" Value="Other">
                                                                    <Setter Property="Foreground" Value="#A8C8DC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <CheckBox Grid.Column="4" Content="Track" Style="{StaticResource SkyTrackCheckBox}"
                                                      IsChecked="{Binding IsTracked}" Margin="10,0,0,0"
                                                      ToolTip="Speak class, reward, and item name when this item is looted" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding DropSourceText}" Foreground="#7A96A8"
                                                       FontSize="13" Margin="0,4,8,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDropSource}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                                        Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Margin="0,4,0,0">
                                                <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,0"
                                                        Background="#C45A2A" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowDeletedCount}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DeletedText}" Foreground="#1A1408"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <Border CornerRadius="6" Padding="8,3" Background="#6A4A20"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowAutosold}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding AutosoldText}" Foreground="#E0C070"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
