<UserControl x:Class="EQLDamageMeter.Controls.SpellNameSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left"
             Width="390">
    <!-- Width fits longest live spell name (55 chars) + 5 extras at UI font size. -->
    <Grid>
        <TextBox x:Name="InputBox"
                 Foreground="#EDF7FF"
                 Background="#A0092235"
                 BorderBrush="#42677F"
                 BorderThickness="1"
                 Padding="10,7"
                 CaretBrush="#9A78FF"
                 VerticalContentAlignment="Center"
                 MaxLength="60"
                 ToolTip="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 TextChanged="InputBox_TextChanged"
                 PreviewKeyDown="InputBox_PreviewKeyDown"
                 LostFocus="InputBox_LostFocus" />
        <Popup x:Name="SuggestionPopup"
               PlacementTarget="{Binding ElementName=InputBox}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border x:Name="SuggestionBorder"
                    Background="#122636" BorderBrush="#5A7F96" BorderThickness="1" CornerRadius="4"
                    MinWidth="{Binding ActualWidth, ElementName=InputBox}" MaxHeight="220"
                    MouseLeftButtonDown="SuggestionBorder_MouseLeftButtonDown">
                <ListBox x:Name="SuggestionList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#EDF7FF"
                         MaxHeight="220"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="SuggestionList_PreviewMouseLeftButtonDown"
                         KeyDown="SuggestionList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#EDF7FF" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A4F68" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#684CC0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
